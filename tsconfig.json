{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": ["engine/**/*.ts", "games/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
